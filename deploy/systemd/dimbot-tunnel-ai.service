[Unit]
Description=Cloudflare Tunnel for Dimbot AI
After=network.target dimbot-ai.service
Requires=dimbot-ai.service

[Service]
Type=simple
User=dimbot
Group=dimbot
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://localhost:8080
Restart=always
RestartSec=10
StandardOutput=append:/home/dimbot/logs/tunnel-ai.log
StandardError=append:/home/dimbot/logs/tunnel-ai.log

[Install]
WantedBy=multi-user.target
