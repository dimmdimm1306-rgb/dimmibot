<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Controls.EmptyState"
             x:Name="Root">
    <Border Style="{StaticResource FiberCard}" BackgroundColor="{DynamicResource CardBg2}">
        <VerticalStackLayout Padding="18,20" Spacing="8" HorizontalOptions="Center">
            <Border WidthRequest="42" HeightRequest="42"
                    BackgroundColor="{DynamicResource AccentBlueBg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8">
                <Label Text="--"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{DynamicResource FiberCyan}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
            <Label Text="{Binding EmptyTitle, Source={x:Reference Root}}"
                   FontAttributes="Bold"
                   FontSize="15"
                   TextColor="{DynamicResource TextPrimary}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding EmptyMessage, Source={x:Reference Root}}"
                   FontSize="12"
                   TextColor="{DynamicResource TextMuted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Border>
</ContentView>
