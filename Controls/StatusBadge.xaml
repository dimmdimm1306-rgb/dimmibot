<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Controls.StatusBadge"
             x:Name="Root">
    <Border BackgroundColor="{Binding BadgeBackground, Source={x:Reference Root}}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            Padding="10,5">
        <Label Text="{Binding BadgeText, Source={x:Reference Root}}"
               TextColor="{Binding BadgeTextColor, Source={x:Reference Root}}"
               FontAttributes="Bold"
               FontSize="11"
               HorizontalTextAlignment="Center" />
    </Border>
</ContentView>
