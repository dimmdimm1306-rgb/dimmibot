<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Controls.SectionHeader"
             x:Name="Root">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
        <Label Grid.Row="0" Grid.Column="0"
               Text="{Binding HeaderTitle, Source={x:Reference Root}}"
               Style="{StaticResource FiberSectionTitle}" />
        <Label Grid.Row="1" Grid.Column="0"
               Text="{Binding HeaderSubtitle, Source={x:Reference Root}}"
               Style="{StaticResource FiberMutedText}"
               LineBreakMode="TailTruncation" />
    </Grid>
</ContentView>
