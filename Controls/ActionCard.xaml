<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Controls.ActionCard"
             x:Name="Root">
    <Border Style="{StaticResource FiberCard}">
        <Grid Padding="14" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    BackgroundColor="{DynamicResource AccentBlueBg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    WidthRequest="42"
                    HeightRequest="42">
                <Label Text="{Binding IconText, Source={x:Reference Root}}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{Binding AccentColor, Source={x:Reference Root}}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
            <Label Grid.Row="0" Grid.Column="1"
                   Text="{Binding CardTitle, Source={x:Reference Root}}"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}"
                   LineBreakMode="TailTruncation" />
            <Label Grid.Row="1" Grid.Column="1"
                   Text="{Binding CardSubtitle, Source={x:Reference Root}}"
                   FontSize="12"
                   TextColor="{DynamicResource TextMuted}"
                   LineBreakMode="TailTruncation" />
        </Grid>
    </Border>
</ContentView>
