<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Controls.LoadingView"
             x:Name="Root">
    <Border Style="{StaticResource FiberCard}" BackgroundColor="{DynamicResource CardBg2}">
        <HorizontalStackLayout Padding="14,12" Spacing="10">
            <ActivityIndicator IsRunning="True"
                               Color="{DynamicResource FiberCyan}"
                               WidthRequest="22"
                               HeightRequest="22" />
            <Label Text="{Binding LoadingText, Source={x:Reference Root}}"
                   FontSize="13"
                   TextColor="{DynamicResource TextSecond}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
