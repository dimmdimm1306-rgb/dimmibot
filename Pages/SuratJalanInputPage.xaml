<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.SuratJalanInputPage"
             Title="Input Surat Jalan"
             BackgroundColor="{DynamicResource PageBg}">

    <ScrollView x:Name="MainScroll">
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Foto card -->
            <Border BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14" Stroke="{DynamicResource BorderClr}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📷  Foto Surat Jalan" FontSize="12" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"/>

                    <!-- Photo viewer in-place: kontrol full via tombol (no gesture) -->
                    <Border x:Name="ImgBox" BackgroundColor="{DynamicResource ImageViewerBg}"
                            StrokeShape="RoundRectangle 10" Stroke="{DynamicResource BorderClr}"
                            StrokeThickness="1" HeightRequest="420">
                        <Grid IsClippedToBounds="True">
                            <Image x:Name="ImgFoto" Aspect="AspectFit" IsVisible="False" AnchorX="0.5" AnchorY="0.5"/>
                            <Label x:Name="LblFotoEmpty" Text="📄  Belum ada foto&#x0a;Pakai Kamera atau Galeri di bawah"
                                   FontSize="12" TextColor="{DynamicResource TextMuted}"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" Opacity="0.7"/>

                            <!-- Pan D-pad (kiri tengah) — UP/LEFT/CENTER-RESET/RIGHT/DOWN -->
                            <Grid x:Name="PanControls" IsVisible="False"
                                  HorizontalOptions="Start" VerticalOptions="Center"
                                  Margin="6,0,0,0" RowSpacing="3" ColumnSpacing="3"
                                  RowDefinitions="40,40,40" ColumnDefinitions="40,40,40">
                                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{DynamicResource ControlBg}"
                                        StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPanUp"/></Border.GestureRecognizers>
                                    <Label Text="⬆" FontSize="18" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{DynamicResource ControlBg}"
                                        StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPanLeft"/></Border.GestureRecognizers>
                                    <Label Text="⬅" FontSize="18" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource ControlBg}"
                                        StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnResetTransform"/></Border.GestureRecognizers>
                                    <Label Text="⟲" FontSize="14" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" BackgroundColor="{DynamicResource ControlBg}"
                                        StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPanRight"/></Border.GestureRecognizers>
                                    <Label Text="➡" FontSize="18" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" BackgroundColor="{DynamicResource ControlBg}"
                                        StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPanDown"/></Border.GestureRecognizers>
                                    <Label Text="⬇" FontSize="18" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>

                            <!-- Zoom + Rotate (kanan tengah) -->
                            <VerticalStackLayout x:Name="ImgControls" IsVisible="False"
                                                 HorizontalOptions="End" VerticalOptions="Center"
                                                 Margin="0,0,6,0" Spacing="6">
                                <Border BackgroundColor="{DynamicResource ControlBg}" StrokeShape="RoundRectangle 22"
                                        WidthRequest="44" HeightRequest="44">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnZoomIn"/></Border.GestureRecognizers>
                                    <Label Text="+" FontSize="22" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border BackgroundColor="#000000B0" StrokeShape="RoundRectangle 22"
                                        WidthRequest="44" HeightRequest="44">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnZoomOut"/></Border.GestureRecognizers>
                                    <Label Text="−" FontSize="22" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border BackgroundColor="#000000B0" StrokeShape="RoundRectangle 22"
                                        WidthRequest="44" HeightRequest="44">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRotate"/></Border.GestureRecognizers>
                                    <Label Text="↻" FontSize="18" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Zoom level indicator (top-left) -->
                            <Border x:Name="LblZoomBadge" IsVisible="False"
                                    BackgroundColor="#000000B0" StrokeShape="RoundRectangle 8"
                                    Padding="8,4" HorizontalOptions="Start" VerticalOptions="Start" Margin="8">
                                <Label x:Name="LblZoom" Text="1.0x" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="8">
                        <Border BackgroundColor="#1D4ED8"
                                StrokeShape="RoundRectangle 10" Padding="14,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTakePhoto"/>
                            </Border.GestureRecognizers>
                            <Label Text="📷 Kamera" FontSize="11" TextColor="White" FontAttributes="Bold"/>
                        </Border>
                        <Border BackgroundColor="#0E7490"
                                StrokeShape="RoundRectangle 10" Padding="14,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickPhoto"/>
                            </Border.GestureRecognizers>
                            <Label Text="🖼 Galeri" FontSize="11" TextColor="White" FontAttributes="Bold"/>
                        </Border>
                        <Border x:Name="BtnRemovePhoto" BackgroundColor="#7F1D1D"
                                StrokeShape="RoundRectangle 10" Padding="14,8" IsVisible="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRemovePhoto"/>
                            </Border.GestureRecognizers>
                            <Label Text="✕ Hapus" FontSize="11" TextColor="White" FontAttributes="Bold"/>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Metadata card -->
            <Border BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14" Stroke="{DynamicResource BorderClr}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📋  Detail Surat Jalan" FontSize="12" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                            <Label Text="Tanggal" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                            <DatePicker x:Name="DpTanggal" Format="d MMM yyyy"
                                        TextColor="{DynamicResource TextPrimary}"
                                        BackgroundColor="{DynamicResource CardBg2}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                            <Label Text="No SJ" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                            <Entry x:Name="EntNoSJ" Placeholder="contoh: SJ-001"
                                   PlaceholderColor="{DynamicResource TextMuted}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource CardBg2}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                            <Label Text="Pengirim" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                            <Entry x:Name="EntPengirim"
                                   PlaceholderColor="{DynamicResource TextMuted}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource CardBg2}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                            <Label Text="Penerima" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                            <Entry x:Name="EntPenerima"
                                   PlaceholderColor="{DynamicResource TextMuted}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource CardBg2}"/>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Segment / RUTE" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                        <Picker x:Name="PkSegment" Title="Pilih segment..."
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource CardBg2}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Keterangan (opsional)" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                        <Entry x:Name="EntKeterangan"
                               PlaceholderColor="{DynamicResource TextMuted}"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource CardBg2}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Items list -->
            <Border BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14" Stroke="{DynamicResource BorderClr}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="📦  Item Barang"
                               FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#166534"
                                StrokeShape="RoundRectangle 10" Padding="11,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddItem"/>
                            </Border.GestureRecognizers>
                            <Label Text="+ Item" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                        </Border>
                    </Grid>
                    <VerticalStackLayout x:Name="ItemsPanel" Spacing="8"/>
                </VerticalStackLayout>
            </Border>

            <!-- Save button -->
            <Border BackgroundColor="#1D4ED8" StrokeShape="RoundRectangle 14" Padding="0,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSave"/>
                </Border.GestureRecognizers>
                <Label Text="💾  Simpan Draft (Offline)" FontSize="13" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center"/>
            </Border>

            <!-- Drafts list header -->
            <BoxView HeightRequest="1" Color="{DynamicResource BorderClr}" Margin="0,8,0,0"/>
            <Label x:Name="LblDrafts" Text="Belum ada draft tersimpan" FontSize="12" FontAttributes="Bold"
                   TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
            <VerticalStackLayout x:Name="DraftsPanel" Spacing="8"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
