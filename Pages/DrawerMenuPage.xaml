<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.DrawerMenuPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource DrawerBg}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ── -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource DrawerHeaderBg}" Padding="20,52,20,20">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="NAVIGASI" FontSize="9" FontAttributes="Bold"
                           TextColor="#3B82F6"/>
                    <Label x:Name="LblProjectName" Text="Project"
                           TextColor="White" FontSize="20" FontAttributes="Bold"
                           LineBreakMode="TailTruncation"/>
                    <Label x:Name="LblProjectDesc" Text=""
                           TextColor="{DynamicResource TextMuted}" FontSize="11"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
                <!-- Close button -->
                <Border Grid.Column="1" BackgroundColor="{DynamicResource HeaderBtnBg}"
                        StrokeShape="RoundRectangle 12" Stroke="{DynamicResource HeaderBtnBorder}"
                        Padding="12,10" VerticalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClose"/>
                    </Border.GestureRecognizers>
                    <Label Text="✕" FontSize="14" FontAttributes="Bold"
                           TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Nav items ── -->
        <ScrollView Grid.Row="1" BackgroundColor="{DynamicResource DrawerBg}">
            <VerticalStackLayout Padding="16,12" Spacing="6">

                <Label Text="HALAMAN UTAMA" FontSize="9" FontAttributes="Bold"
                       TextColor="{DynamicResource BorderClr}" Margin="4,8,0,4"/>

                <!-- Surat Jalan -->
                <Border x:Name="NavSJ" BackgroundColor="{DynamicResource DrawerItemBg}"
                        StrokeShape="RoundRectangle 14" Stroke="{DynamicResource DrawerItemBorder}"
                        Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavSuratJalan"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#1E3A6E"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="40" HeightRequest="40">
                            <Label Text="📋" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Surat Jalan" FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="Riwayat keluar-masuk material" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{DynamicResource BorderClr}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Progress -->
                <Border x:Name="NavProg" BackgroundColor="{DynamicResource DrawerItemBg}"
                        StrokeShape="RoundRectangle 14" Stroke="{DynamicResource DrawerItemBorder}"
                        Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProgress"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#0E4429"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="40" HeightRequest="40">
                            <Label Text="📡" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Progress" FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="Progres pemasangan per segment" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{DynamicResource BorderClr}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Stok Diterima -->
                <Border x:Name="NavStokA" BackgroundColor="{DynamicResource DrawerItemBg}"
                        StrokeShape="RoundRectangle 14" Stroke="{DynamicResource DrawerItemBorder}"
                        Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavStokAktual"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#3B0764"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="40" HeightRequest="40">
                            <Label Text="📦" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Stok Diterima" FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="Stok material per homebase / MRF" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{DynamicResource BorderClr}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Stok Gudang -->
                <Border x:Name="NavStokG" BackgroundColor="{DynamicResource DrawerItemBg}"
                        StrokeShape="RoundRectangle 14" Stroke="{DynamicResource DrawerItemBorder}"
                        Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavStokGudang"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#431407"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="40" HeightRequest="40">
                            <Label Text="🏭" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Stok Gudang" FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="Detail stok per wilayah gudang" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{DynamicResource BorderClr}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Input -->
                <Border x:Name="NavInput" BackgroundColor="{DynamicResource DrawerItemBg}"
                        StrokeShape="RoundRectangle 14" Stroke="{DynamicResource DrawerItemBorder}"
                        Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavInput"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#1E40AF"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="40" HeightRequest="40">
                            <Label Text="✏️" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Input Data" FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="Surat Jalan + Progress" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{DynamicResource BorderClr}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Kegiatan -->
                <Border x:Name="NavAbsensi" BackgroundColor="{DynamicResource DrawerItemBg}"
                        StrokeShape="RoundRectangle 14" Stroke="{DynamicResource DrawerItemBorder}"
                        Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavAbsensi"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#7C2D12"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="40" HeightRequest="40">
                            <Label Text="📸" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Kegiatan" FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="Foto + caption (multi-foto carousel)" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{DynamicResource BorderClr}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Bottom actions ── -->
        <VerticalStackLayout Grid.Row="2" BackgroundColor="{DynamicResource DrawerBottomBg}"
                             Padding="16,12" Spacing="8">
            <BoxView HeightRequest="1" Color="{DynamicResource DrawerItemBorder}" Margin="0,0,0,4"/>

            <!-- Ganti Project -->
            <Border BackgroundColor="{DynamicResource HeaderBtnBg}"
                    StrokeShape="RoundRectangle 12" Stroke="{DynamicResource HeaderBtnBorder}"
                    Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToProjects"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="🏠" FontSize="18" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Ganti Project"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                </Grid>
            </Border>

        </VerticalStackLayout>

    </Grid>
</ContentPage>
