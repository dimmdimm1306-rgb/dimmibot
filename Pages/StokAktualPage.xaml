<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.StokAktualPage"
             Title="Stok Diterima"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header + Legenda -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{DynamicResource HeaderBg}" Padding="14,14" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <!-- Hamburger -->
                <Border Grid.Column="0" BackgroundColor="{DynamicResource AccentBlueBg}"
                        StrokeShape="RoundRectangle 10" Stroke="{DynamicResource AccentBlueBorder}" StrokeThickness="1.5"
                        Padding="12,8" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHamburger"/>
                    </Border.GestureRecognizers>
                    <Label Text="≡" FontSize="24" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Grid.Column="1" Text="📦 Stok Material per Homebase" TextColor="White"
                       FontSize="17" FontAttributes="Bold" VerticalOptions="Center"/>
                <!-- Theme + AI Bot + Refresh -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Border BackgroundColor="{DynamicResource HeaderBtnBg}"
                            StrokeShape="RoundRectangle 12" Stroke="{DynamicResource HeaderBtnBorder}" StrokeThickness="1"
                            Padding="11,9" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThemeToggle"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="LblTheme" Text="☀" FontSize="15" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border BackgroundColor="#6366F1"
                            StrokeShape="RoundRectangle 12" Stroke="#818CF8" StrokeThickness="1"
                            Padding="6" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAiBotClicked"/>
                        </Border.GestureRecognizers>
                        <Image Source="claw_cat.png" WidthRequest="26" HeightRequest="26"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border BackgroundColor="#1D4ED8"
                            StrokeShape="RoundRectangle 12" Stroke="#3B82F6" StrokeThickness="1"
                            Padding="11,9" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUpdateTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="↻" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
            <Label Text="Kebutuhan · Diterima · Kekurangan" TextColor="{DynamicResource HeaderSubtitle}" FontSize="12"/>
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                <Border Grid.Column="0" BackgroundColor="{DynamicResource CardBg2}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="7,3">
                    <Label Text="■ Material Inti" FontSize="9" TextColor="#1D4ED8"/>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#FFF7ED" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="7,3">
                    <Label Text="■ Additional" FontSize="9" TextColor="#C2410C"/>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#DCFCE7" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="7,3">
                    <Label Text="+ Surplus" FontSize="9" TextColor="#15803D"/>
                </Border>
                <Border Grid.Column="3" BackgroundColor="#FEE2E2" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="7,3">
                    <Label Text="– Kurang" FontSize="9" TextColor="#B91C1C"/>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <ActivityIndicator x:Name="Loader" Grid.Row="1" IsRunning="False" IsVisible="False"
                           Color="#2563EB" HeightRequest="36"/>

        <CollectionView x:Name="List" Grid.Row="2" SelectionMode="None"
                        BackgroundColor="{DynamicResource PageBg}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,60,0,0">
                    <Label Text="📦" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Tidak ada data stok" TextColor="#9CA3AF" FontSize="15" HorizontalOptions="Center"/>
                    <Label Text="Tekan 🔄 Update untuk memuat data" TextColor="#D1D5DB" FontSize="13" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,5">
                            <Border BackgroundColor="{DynamicResource CardBg}" StrokeShape="RoundRectangle 16" Stroke="{DynamicResource BorderClr}" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.07"/>
                                </Border.Shadow>
                                <VerticalStackLayout Padding="14,12" Spacing="0">

                                    <!-- Homebase + Status badge -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Homebase}" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource TextPrimary}"/>
                                            <Label Text="{Binding Segment}" FontSize="11" TextColor="{DynamicResource TextMuted}"
                                                   MaxLines="2" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}"
                                                StrokeShape="RoundRectangle 12" Padding="10,5" Stroke="Transparent"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding StatusText}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{DynamicResource BorderClr}" Margin="0,0,0,6"/>

                                    <!-- Header tabel -->
                                    <Border BackgroundColor="#1E40AF" StrokeShape="RoundRectangle 6" Stroke="Transparent" Margin="0,0,0,3">
                                        <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                            <Label Text="Nama Barang"   FontSize="10" TextColor="White"   FontAttributes="Bold"/>
                                            <Label Grid.Column="1" Text="Kebutuhan"  FontSize="9"  TextColor="#BFDBFE" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="2" Text="Diterima"   FontSize="9"  TextColor="#BFDBFE" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="3" Text="Kekurangan" FontSize="9"  TextColor="#BFDBFE" FontAttributes="Bold" HorizontalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Kabel 24C -->
                                    <Border BackgroundColor="{DynamicResource CardBg2}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Margin="0,2">
                                        <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                            <Label Text="Kabel 24C  (m)" FontSize="12" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding K24C_Keb}" FontSize="12" TextColor="#1D4ED8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="{Binding K24C_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="3" Text="{Binding K24C_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Tiang 7 -->
                                    <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                        <Label Text="Tiang 7m  (btg)" FontSize="12" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding T7_Keb}" FontSize="12" TextColor="#1D4ED8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding T7_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="3" Text="{Binding T7_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- Tiang 9 -->
                                    <Border BackgroundColor="{DynamicResource CardBg2}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Margin="0,2">
                                        <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                            <Label Text="Tiang 9m  (btg)" FontSize="12" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding T9_Keb}" FontSize="12" TextColor="#1D4ED8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="{Binding T9_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="3" Text="{Binding T9_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Strength Clamp 25/50 -->
                                    <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                        <Label Text="Strength Clamp 25/50  (pcs)" FontSize="10" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding SC_Keb}" FontSize="12" TextColor="#1D4ED8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding SC_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="3" Text="{Binding SC_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- X Frame 80x80 -->
                                    <Border BackgroundColor="{DynamicResource CardBg2}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Margin="0,2">
                                        <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                            <Label Text="X Frame 80×80  (pcs)" FontSize="11" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding XF_Keb}" FontSize="12" TextColor="#1D4ED8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="{Binding XF_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="3" Text="{Binding XF_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Closure 24C Komplit -->
                                    <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                        <Label Text="Closure 24C (Komplit)  (pcs)" FontSize="10" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding CL_Keb}" FontSize="12" TextColor="#1D4ED8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding CL_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="3" Text="{Binding CL_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- ODP 8 Port + Aksesori -->
                                    <Border BackgroundColor="{DynamicResource CardBg2}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Margin="0,2">
                                        <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                            <Label Text="ODP 8 Port + Aksesori  (set)" FontSize="10" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding ODP_Keb}" FontSize="12" TextColor="#1D4ED8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="{Binding ODP_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="3" Text="{Binding ODP_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Pigtail SC/UPC 1 meter -->
                                    <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                        <Label Text="Pigtail SC/UPC 1m  (pcs)" FontSize="11" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding PG_Keb}" FontSize="12" TextColor="#1D4ED8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding PG_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="3" Text="{Binding PG_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- Connector SC/UPC - Feeder -->
                                    <Border BackgroundColor="{DynamicResource CardBg2}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Margin="0,2">
                                        <Grid ColumnDefinitions="*,55,55,65" Padding="8,6">
                                            <Label Text="Connector SC/UPC  (pcs)" FontSize="11" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding CN_Keb}" FontSize="12" TextColor="#1D4ED8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="{Binding CN_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Label Grid.Column="3" Text="{Binding CN_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Patchcord 5M SC/UPC-LC/UPC Duplex Outdoor -->
                                    <Grid ColumnDefinitions="*,55,55,65" Padding="8,6" Margin="0,0,0,8">
                                        <Label Text="Patchcord 5M SC/UPC  (pcs)" FontSize="10" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding PC_Keb}" FontSize="12" TextColor="#1D4ED8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding PC_Ter}" FontSize="12" TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Column="3" Text="{Binding PC_Kek}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- ══ Divider + Label ADDITIONAL ══ -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,4">
                                        <Border Grid.Column="0" BackgroundColor="#EA580C" Stroke="Transparent"
                                                StrokeShape="RoundRectangle 4" Padding="7,2">
                                            <Label Text="ADDITIONAL" FontSize="9" FontAttributes="Bold" TextColor="White"/>
                                        </Border>
                                        <BoxView Grid.Column="1" HeightRequest="1" Color="#FED7AA" VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- Header additional -->
                                    <Border BackgroundColor="#C2410C" StrokeShape="RoundRectangle 6" Stroke="Transparent" Margin="0,0,0,3">
                                        <Grid ColumnDefinitions="*,Auto" Padding="8,5">
                                            <Label Text="Nama Barang" FontSize="10" TextColor="White" FontAttributes="Bold"/>
                                            <Label Grid.Column="1" Text="Diterima" FontSize="9" TextColor="#FFEDD5" FontAttributes="Bold"/>
                                        </Grid>
                                    </Border>

                                    <!-- Kabel 12C -->
                                    <Border BackgroundColor="#FFF7ED" Stroke="#FDBA74" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6" Margin="0,2,0,0">
                                        <Grid ColumnDefinitions="*,Auto" Padding="10,8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="Kabel 12C  (m)" FontSize="13" TextColor="#C2410C" FontAttributes="Bold"/>
                                                <Label Text="Stok langsung datang, tidak ada target kebutuhan"
                                                       FontSize="9" TextColor="#9A3412"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding K12C_Ter}" FontSize="16"
                                                   FontAttributes="Bold" TextColor="#EA580C"
                                                   VerticalOptions="Center" HorizontalOptions="End"/>
                                        </Grid>
                                    </Border>

                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
