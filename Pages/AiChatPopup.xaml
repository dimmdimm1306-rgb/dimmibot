<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.AiChatPopup"
             Title="AI Assistant"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource HeaderBg}" Padding="14,14,14,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{DynamicResource AccentBlueBg}"
                        StrokeShape="RoundRectangle 10" Stroke="{DynamicResource AccentBlueBorder}" StrokeThickness="1.5"
                        Padding="12,8" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="✕" FontSize="20" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="10">
                    <Border BackgroundColor="{DynamicResource AiBotBg}"
                            StrokeShape="RoundRectangle 16" Stroke="{DynamicResource AiBotBorder}" StrokeThickness="1"
                            WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                        <Label Text="AI" FontSize="13" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="AI Assistant" TextColor="White"
                               FontSize="18" FontAttributes="Bold"/>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Tanya apa saja tentang pekerjaan Anda" TextColor="{DynamicResource HeaderSubtitle}"
                                   FontSize="11"/>
                            <Label x:Name="AuthStatusLabel" Text="" TextColor="#10B981"
                                   FontSize="10" FontAttributes="Bold" IsVisible="False"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Border BackgroundColor="#DC2626"
                            StrokeShape="RoundRectangle 10" Stroke="Transparent"
                            Padding="10,6" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearChat"/>
                        </Border.GestureRecognizers>
                        <Label Text="🗑️ Clear" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!-- Chat Messages -->
        <ScrollView Grid.Row="1" x:Name="ChatScrollView" Padding="14">
            <VerticalStackLayout x:Name="MessagesContainer" Spacing="12">
                <!-- Welcome message -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalOptions="Start">
                    <Border Grid.Column="0" BackgroundColor="{DynamicResource AiBotBg}"
                            StrokeShape="RoundRectangle 14" Stroke="{DynamicResource AiBotBorder}" StrokeThickness="1"
                            WidthRequest="32" HeightRequest="32"
                            VerticalOptions="Start" Margin="0,4,0,0">
                        <Label Text="AI" FontSize="11" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource BorderClr}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12"
                            MaximumWidthRequest="280">
                        <Label Text="👋 Halo! Saya AI assistant kamu. Tanya apa aja — soal pekerjaan, progress, stok, atau mau ngobrol santai juga boleh!"
                               TextColor="{DynamicResource TextPrimary}"
                               FontSize="13"
                               LineBreakMode="WordWrap"/>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Input Area -->
        <Grid Grid.Row="2" BackgroundColor="{DynamicResource HeaderBg}" 
              Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            
            <Border Grid.Column="0" BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 20"
                    Stroke="{DynamicResource BorderClr}"
                    Padding="14,10">
                <Entry x:Name="MessageEntry"
                       Placeholder="Ketik pesan Anda..."
                       PlaceholderColor="{DynamicResource TextMuted}"
                       TextColor="{DynamicResource TextPrimary}"
                       FontSize="14"
                       Completed="OnSendMessage"/>
            </Border>

            <Border Grid.Column="1" BackgroundColor="{DynamicResource AiBotBg}"
                    StrokeShape="RoundRectangle 22"
                    Padding="16,12"
                    WidthRequest="50"
                    HeightRequest="50">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSendMessage"/>
                </Border.GestureRecognizers>
                <Label Text="➤" FontSize="20" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       FontAttributes="Bold"/>
            </Border>
        </Grid>

        <!-- Loading Indicator -->
        <Grid Grid.Row="0" Grid.RowSpan="3" 
              x:Name="LoadingOverlay"
              IsVisible="False"
              BackgroundColor="#80000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="40" HeightRequest="40"/>
                <Label Text="AI sedang berpikir..." TextColor="White" FontSize="14" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
