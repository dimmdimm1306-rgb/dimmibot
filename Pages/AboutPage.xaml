<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.AboutPage"
             Title="About"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource HeaderBg}" Padding="14,14,14,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{DynamicResource AccentBlueBg}"
                        StrokeShape="RoundRectangle 10" Stroke="{DynamicResource AccentBlueBorder}" StrokeThickness="1.5"
                        Padding="12,8" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="" FontSize="24" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text=" About Aplikasi" TextColor="White"
                           FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Info versi, config, dan diagnostics" TextColor="{DynamicResource HeaderSubtitle}"
                           FontSize="11"/>
                </VerticalStackLayout>

                <Border Grid.Column="2" BackgroundColor="{DynamicResource AccentBlueBg}"
                        StrokeShape="RoundRectangle 10" Stroke="{DynamicResource AccentBlueBorder}" StrokeThickness="1.5"
                        Padding="12,8" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefresh"/>
                    </Border.GestureRecognizers>
                    <Label Text="" FontSize="20" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="14">
            <VerticalStackLayout Spacing="14">

                <!-- App version card -->
                <Border BackgroundColor="#1E3A6E"
                        StrokeShape="RoundRectangle 14" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text=" APLIKASI" TextColor="#93C5FD" FontSize="10" FontAttributes="Bold"/>
                        <Label x:Name="LblAppName" Text="StokBarangMAUI" TextColor="White"
                               FontSize="20" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Text="Versi:" TextColor="#93C5FD" FontSize="12"/>
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblAppVersion" Text="1.0" TextColor="White" FontSize="12"/>
                            <Label Grid.Row="1" Grid.Column="0" Text="Build:" TextColor="#93C5FD" FontSize="12"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblAppBuild" Text="1" TextColor="White" FontSize="12"/>
                        </Grid>
                        <Label Text="Dibuat oleh Dimas" TextColor="#BFDBFE" FontSize="11" Margin="0,6,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Remote Config from GitHub -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource BorderClr}"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text=" Remote Config (GitHub)"
                                   TextColor="{DynamicResource TextPrimary}"
                                   FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Border Grid.Column="1" BackgroundColor="#6366F1"
                                    StrokeShape="RoundRectangle 8" Padding="10,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFetchGithub"/>
                                </Border.GestureRecognizers>
                                <Label Text=" Fetch" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <Label x:Name="LblGithubUrl" Text="github raw url..."
                               TextColor="{DynamicResource TextMuted}" FontSize="10" LineBreakMode="CharacterWrap">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCopyGithubUrl"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <BoxView HeightRequest="1" Color="{DynamicResource BorderClr}"/>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Config version:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblCfgVersion" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="12" FontAttributes="Bold"/>

                            <Label Grid.Row="1" Grid.Column="0" Text="Last tested:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblCfgLastTested" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="12"/>

                            <Label Grid.Row="2" Grid.Column="0" Text="AI base URL:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="LblAiBaseUrl" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="11" LineBreakMode="CharacterWrap">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCopyAiUrl"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Grid.Row="3" Grid.Column="0" Text="AI model:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="3" Grid.Column="1" x:Name="LblAiModel" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="11"/>

                            <Label Grid.Row="4" Grid.Column="0" Text="Drive URL:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="4" Grid.Column="1" x:Name="LblDriveUrl" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="11" LineBreakMode="CharacterWrap">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCopyDriveUrl"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Grid.Row="5" Grid.Column="0" Text="Drive enabled:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="5" Grid.Column="1" x:Name="LblDriveEnabled" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="12"/>
                        </Grid>

                        <Label Text=" Tap alamat untuk copy ke clipboard"
                               TextColor="{DynamicResource TextMuted}" FontSize="10"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Live Diagnostics -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource BorderClr}"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text=" Live Diagnostics"
                                   TextColor="{DynamicResource TextPrimary}"
                                   FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Border Grid.Column="1" BackgroundColor="#10B981"
                                    StrokeShape="RoundRectangle 8" Padding="10,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRunDiagnostics"/>
                                </Border.GestureRecognizers>
                                <Label Text=" Run" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <Label x:Name="LblDiagnostics" Text="Klik  Run untuk test koneksi"
                               TextColor="{DynamicResource TextSecond}" FontSize="12"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Local Preferences -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource BorderClr}"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text=" Local Preferences"
                               TextColor="{DynamicResource TextPrimary}"
                               FontSize="14" FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="AI URL (local):" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblLocalAiUrl" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="11" LineBreakMode="CharacterWrap"/>

                            <Label Grid.Row="1" Grid.Column="0" Text="AI model (local):" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblLocalAiModel" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="11"/>

                            <Label Grid.Row="2" Grid.Column="0" Text="Drive URL (local):" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="LblLocalDriveUrl" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="11" LineBreakMode="CharacterWrap"/>

                            <Label Grid.Row="3" Grid.Column="0" Text="Drive token set:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="3" Grid.Column="1" x:Name="LblLocalDriveToken" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="11"/>
                        </Grid>

                        <Border BackgroundColor="#DC2626"
                                StrokeShape="RoundRectangle 8" Padding="12,10" Margin="0,6,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResetPreferences"/>
                            </Border.GestureRecognizers>
                            <Label Text=" Reset Local Preferences (pakai config GitHub)" 
                                   TextColor="White" FontSize="12" FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Device info -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource BorderClr}"
                        Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text=" Device"
                               TextColor="{DynamicResource TextPrimary}"
                               FontSize="14" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Platform:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblPlatform" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="12"/>
                            <Label Grid.Row="1" Grid.Column="0" Text="OS version:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblOsVersion" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="12"/>
                            <Label Grid.Row="2" Grid.Column="0" Text="Model:" TextColor="{DynamicResource TextSecond}" FontSize="12"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="LblDeviceModel" Text="-" TextColor="{DynamicResource TextPrimary}" FontSize="12"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
