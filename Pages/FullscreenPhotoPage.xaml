<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.FullscreenPhotoPage"
             Title="Foto"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#000000">

    <Grid>
        <!-- Image fills screen, gestures attached. NO parent ScrollView → gestures work perfectly. -->
        <Image x:Name="ImgFoto" Aspect="AspectFit" AnchorX="0.5" AnchorY="0.5">
            <Image.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinch"/>
                <PanGestureRecognizer   PanUpdated="OnPan"/>
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTap"/>
            </Image.GestureRecognizers>
        </Image>

        <!-- Top bar -->
        <Grid VerticalOptions="Start" Padding="12,40,12,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border Grid.Column="0" BackgroundColor="#000000B0"
                    StrokeShape="RoundRectangle 10" Padding="12,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClose"/>
                </Border.GestureRecognizers>
                <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="White"/>
            </Border>
            <HorizontalStackLayout Grid.Column="2" Spacing="8">
                <Border BackgroundColor="#000000B0" StrokeShape="RoundRectangle 10" Padding="12,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRotate"/>
                    </Border.GestureRecognizers>
                    <Label Text="↻" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                </Border>
                <Border BackgroundColor="#000000B0" StrokeShape="RoundRectangle 10" Padding="12,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReset"/>
                    </Border.GestureRecognizers>
                    <Label Text="⟲" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- Bottom hint -->
        <Label x:Name="LblHint" Text="Pinch zoom · Geser untuk pan · ↻ rotate · ⟲ reset"
               VerticalOptions="End" HorizontalOptions="Center"
               Margin="0,0,0,28" FontSize="10" TextColor="#FFFFFFA0"/>
    </Grid>
</ContentPage>
