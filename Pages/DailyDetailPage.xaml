<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.DailyDetailPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource HeaderBg}" Padding="14,14">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" BackgroundColor="#1E293B"
                        StrokeShape="RoundRectangle 12" Stroke="#334155" StrokeThickness="1"
                        Padding="12,10" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBack"/>
                    </Border.GestureRecognizers>
                    <Label Text="‹" FontSize="20" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="LblHari" Text="Hari" TextColor="#93C5FD"
                           FontSize="10" FontAttributes="Bold"/>
                    <Label x:Name="LblTanggal" Text="–"
                           TextColor="White" FontSize="18" FontAttributes="Bold"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
                <!-- Tombol Share/Report WhatsApp -->
                <Border Grid.Column="2" BackgroundColor="#15803D"
                        StrokeShape="RoundRectangle 12" Stroke="#16A34A" StrokeThickness="1"
                        Padding="11,9" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShareReport"/>
                    </Border.GestureRecognizers>
                    <Label Text="📤" FontSize="15" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Column="3" BackgroundColor="#1E293B"
                        StrokeShape="RoundRectangle 12" Stroke="#334155" StrokeThickness="1"
                        Padding="11,9" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnThemeToggle"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="LblTheme" Text="☀" FontSize="15" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Stats summary -->
        <Grid Grid.Row="1" BackgroundColor="{DynamicResource SubHeaderBg}"
              Padding="14,10" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border Grid.Column="0" BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 12" Stroke="{DynamicResource BorderClr}" Padding="10,10">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="LblTotal" Text="–" FontSize="20" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center"/>
                    <Label Text="Aktivitas" FontSize="9" TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 12" Stroke="{DynamicResource BorderClr}" Padding="10,10">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="LblSeg" Text="–" FontSize="20" FontAttributes="Bold"
                           TextColor="#60A5FA" HorizontalOptions="Center"/>
                    <Label Text="Segment" FontSize="9" TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 12" Stroke="{DynamicResource BorderClr}" Padding="10,10">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="LblDone" Text="–" FontSize="20" FontAttributes="Bold"
                           TextColor="#4ADE80" HorizontalOptions="Center"/>
                    <Label Text="Done" FontSize="9" TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="2" Margin="14,8,14,4">
            <Border BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{DynamicResource BorderClr}" StrokeThickness="1.5">
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="10,0" ColumnSpacing="6">
                    <Label Grid.Column="0" Text="🔍" FontSize="15"
                           VerticalOptions="Center" Opacity="0.55"/>
                    <Entry Grid.Column="1" x:Name="SearchEntry"
                           Placeholder="Cari segment / span / nama barang..."
                           PlaceholderColor="{DynamicResource TextMuted}"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="Transparent"
                           FontSize="12" HeightRequest="42"
                           TextChanged="OnSearchChanged"/>
                    <Border Grid.Column="2" x:Name="BtnClear"
                            BackgroundColor="{DynamicResource CardBg2}"
                            StrokeShape="RoundRectangle 7" Stroke="Transparent"
                            Padding="6,4" VerticalOptions="Center" IsVisible="False">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearSearch"/>
                        </Border.GestureRecognizers>
                        <Label Text="✕" FontSize="10" TextColor="{DynamicResource TextMuted}"
                               FontAttributes="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- List of progress entries -->
        <CollectionView Grid.Row="3" x:Name="ItemList" SelectionMode="None"
                        BackgroundColor="{DynamicResource PageBg}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,60">
                    <Label Text="📭" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Tidak ada progres pada hari ini"
                           TextColor="{DynamicResource TextMuted}"
                           FontSize="13" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="14,6">
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{DynamicResource BorderClr}" StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.14"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="5,*">
                                <BoxView Grid.Column="0" Color="{Binding StatusColor}"
                                         CornerRadius="16,0,0,16"/>
                                <VerticalStackLayout Grid.Column="1" Padding="14,14" Spacing="10">

                                    <!-- Span + Status -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Span}" FontAttributes="Bold" FontSize="15"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding Segment, StringFormat='📍 {0}'}"
                                                   FontSize="11" TextColor="#60A5FA"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}"
                                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                                Padding="10,4" VerticalOptions="Start">
                                            <Label Text="{Binding StatusText}" FontSize="10"
                                                   FontAttributes="Bold" TextColor="White"/>
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{DynamicResource BorderClr}" Opacity="0.7"/>

                                    <!-- Material list (digabung jika satu span ada banyak material) -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Materials}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Text="{Binding NamaBarang}"
                                                           FontSize="12.5"
                                                           TextColor="{DynamicResource TextPrimary}"
                                                           VerticalOptions="Center"
                                                           LineBreakMode="WordWrap"/>
                                                    <Border Grid.Column="1" BackgroundColor="#1E3A6E"
                                                            StrokeShape="RoundRectangle 8"
                                                            Stroke="#2563EB" StrokeThickness="1.2"
                                                            Padding="10,5" VerticalOptions="Center">
                                                        <Label Text="{Binding QtyText}"
                                                               FontSize="13" FontAttributes="Bold"
                                                               TextColor="#93C5FD"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!-- Keterangan + Homebase -->
                                    <Label Text="{Binding KeteranganText}"
                                           FontSize="11" TextColor="{DynamicResource TextSecond}"
                                           FontAttributes="Italic"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding HasKeterangan}"/>

                                    <Border BackgroundColor="{DynamicResource CardBg2}"
                                            StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                            Padding="10,5" HorizontalOptions="Start"
                                            IsVisible="{Binding HasHomebase}">
                                        <Label Text="{Binding Homebase, StringFormat='🏠 {0}'}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}"/>
                                    </Border>

                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
