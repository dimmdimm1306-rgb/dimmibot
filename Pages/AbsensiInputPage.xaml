<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.AbsensiInputPage"
             Title="Kegiatan Baru"
             BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">

            <!-- Photo grid (multi) -->
            <VerticalStackLayout Padding="14,12,14,4" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="📷  Foto Kegiatan (bisa lebih dari 1)"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" x:Name="LblPhotoCount" Text="0 foto"
                           FontSize="10" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center"/>
                </Grid>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="PhotosPanel" Spacing="6"/>
                </ScrollView>
                <HorizontalStackLayout Spacing="8">
                    <Border BackgroundColor="#1D4ED8" StrokeShape="RoundRectangle 10" Padding="14,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTakePhoto"/>
                        </Border.GestureRecognizers>
                        <Label Text="📷 Kamera" FontSize="11" TextColor="White" FontAttributes="Bold"/>
                    </Border>
                    <Border BackgroundColor="#0E7490" StrokeShape="RoundRectangle 10" Padding="14,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickPhotos"/>
                        </Border.GestureRecognizers>
                        <Label Text="🖼 Galeri (multi)" FontSize="11" TextColor="White" FontAttributes="Bold"/>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{DynamicResource BorderClr}" Margin="0,8"/>

            <!-- Caption -->
            <VerticalStackLayout Padding="14,0" Spacing="6">
                <Label Text="📝 Caption" FontSize="11" TextColor="{DynamicResource TextMuted}"/>
                <Editor x:Name="EntCaption" Placeholder="Tulis catatan singkat..."
                        AutoSize="TextChanges"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        TextColor="{DynamicResource TextPrimary}"
                        BackgroundColor="{DynamicResource CardBg2}"
                        FontSize="13" HeightRequest="80"/>
            </VerticalStackLayout>

            <!-- Detail -->
            <Border Margin="14,12" BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14" Stroke="{DynamicResource BorderClr}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📋  Detail Kegiatan" FontSize="12" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"/>

                    <VerticalStackLayout Spacing="3">
                        <Label Text="Segment / RUTE *" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                        <Picker x:Name="PkSegment" Title="Pilih segment..."
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource CardBg2}"
                                SelectedIndexChanged="OnSegmentChanged"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="3">
                        <Label Text="Span * (ketik untuk cari)" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                        <Entry x:Name="EntSpan" Placeholder="Pilih segment dulu, lalu ketik nama span..."
                               PlaceholderColor="{DynamicResource TextMuted}"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource CardBg2}"
                               TextChanged="OnSpanTextChanged"/>
                        <Border x:Name="SpanSuggestionsCard" IsVisible="False"
                                BackgroundColor="{DynamicResource CardBg2}"
                                StrokeShape="RoundRectangle 10" Stroke="#3B82F6" StrokeThickness="1"
                                Margin="0,4,0,0" MaximumHeightRequest="220">
                            <ScrollView>
                                <VerticalStackLayout x:Name="SpanSuggestionsPanel" Padding="4" Spacing="2"/>
                            </ScrollView>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="3">
                        <Label Text="Pekerjaan" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                        <Entry x:Name="EntPekerjaan" Placeholder="contoh: Penarikan Kabel 24C"
                               PlaceholderColor="{DynamicResource TextMuted}"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource CardBg2}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Waspang" FontSize="10" TextColor="{DynamicResource TextMuted}"/>
                        <Entry x:Name="EntWaspang" Placeholder="Nama waspang"
                               PlaceholderColor="{DynamicResource TextMuted}"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource CardBg2}"/>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="👷  Ketua Regu (1+)"
                               FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#166534" StrokeShape="RoundRectangle 10" Padding="11,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddKetua"/>
                            </Border.GestureRecognizers>
                            <Label Text="+ Ketua" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                        </Border>
                    </Grid>
                    <VerticalStackLayout x:Name="KetuaPanel" Spacing="6"/>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="LblTime" Text="" FontSize="10" TextColor="{DynamicResource TextMuted}"
                   HorizontalOptions="Center" Margin="0,0,0,8"/>

            <Border Margin="14,0,14,16" BackgroundColor="#16A34A" StrokeShape="RoundRectangle 14" Padding="0,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPost"/>
                </Border.GestureRecognizers>
                <Label x:Name="LblPostBtn" Text="🚀  Post ke Drive" FontSize="13" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center"/>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
