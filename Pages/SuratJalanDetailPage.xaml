<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.SuratJalanDetailPage"
             Title="Detail Surat Jalan"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ── -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{DynamicResource HeaderBg}"
                             Padding="16,14" Spacing="8">
            <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="12">
                <BoxView Grid.Column="0" x:Name="StripColor"
                         CornerRadius="3" VerticalOptions="Fill"/>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label x:Name="LblNama" FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" LineBreakMode="WordWrap"/>
                    <Label x:Name="LblSegment" FontSize="12"
                           TextColor="{DynamicResource TextMuted}" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
                <Border Grid.Column="2" x:Name="BadgeBorder"
                        StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        Padding="12,6" VerticalOptions="Start">
                    <Label x:Name="LblJenis" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- ── Info rows ── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="10">

                <!-- Daftar material -->
                <Border BackgroundColor="{DynamicResource AccentBlueBg}" StrokeShape="RoundRectangle 14"
                        Stroke="{DynamicResource AccentBlueBorder}" StrokeThickness="1" Padding="14,12">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="DAFTAR MATERIAL" FontSize="9" FontAttributes="Bold"
                               TextColor="#93C5FD" Margin="0,0,0,10"/>
                        <VerticalStackLayout x:Name="ItemsPanel" Spacing="0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Detail card -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{DynamicResource BorderClr}" StrokeThickness="1"
                        Padding="16,12">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="120,*" Padding="0,10">
                            <Label Text="Tanggal" FontSize="12" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center"/>
                            <Label x:Name="LblTanggal" Grid.Column="1" FontSize="13"
                                   FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderClr}"/>
                        <Grid ColumnDefinitions="120,*" Padding="0,10">
                            <Label Text="No. Surat Jalan" FontSize="12" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center"/>
                            <Label x:Name="LblNoSJ" Grid.Column="1" FontSize="13"
                                   FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderClr}"/>
                        <Grid ColumnDefinitions="120,*" Padding="0,10">
                            <Label Text="Pengirim" FontSize="12" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center"/>
                            <Label x:Name="LblPengirim" Grid.Column="1" FontSize="13"
                                   TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderClr}"/>
                        <Grid ColumnDefinitions="120,*" Padding="0,10">
                            <Label Text="Penerima" FontSize="12" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center"/>
                            <Label x:Name="LblPenerima" Grid.Column="1" FontSize="13"
                                   FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                        </Grid>
                        <BoxView x:Name="KetDivider" HeightRequest="1" Color="{DynamicResource BorderClr}"/>
                        <Grid x:Name="KetRow" ColumnDefinitions="120,*" Padding="0,10">
                            <Label Text="Keterangan" FontSize="12" TextColor="{DynamicResource TextMuted}" VerticalOptions="Start" Margin="0,2,0,0"/>
                            <Label x:Name="LblKeterangan" Grid.Column="1" FontSize="12"
                                   TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Segment card -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{DynamicResource BorderClr}" StrokeThickness="1"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="SEGMENT / WILAYAH" FontSize="10" FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}"/>
                        <Label x:Name="LblSegmentFull" FontSize="14"
                               TextColor="{DynamicResource TextPrimary}" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Buka Surat Jalan button ── -->
        <Border x:Name="BtnBukaSJ" Grid.Row="2"
                BackgroundColor="{DynamicResource AccentBlue}" StrokeShape="RoundRectangle 0"
                Stroke="Transparent" Padding="0,18" IsVisible="False">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBukaSJ"/>
            </Border.GestureRecognizers>
            <Label Text="📎  Buka Surat Jalan" FontSize="16" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center"/>
        </Border>

    </Grid>
</ContentPage>
