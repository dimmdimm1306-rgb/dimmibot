<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.LoginPage"
             Title="Login"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid Padding="24" RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1" Spacing="18">
            <Label Text="🔒  Login Editor" FontSize="22" FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center"/>
            <Label Text="Hanya email yang sudah di-whitelist yang bisa edit data."
                   FontSize="11" TextColor="{DynamicResource TextMuted}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

            <Border BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14" Stroke="{DynamicResource BorderClr}"
                    Padding="14,4">
                <Entry x:Name="EntEmail" Placeholder="email@gmail.com"
                       Keyboard="Email"
                       PlaceholderColor="{DynamicResource TextMuted}"
                       TextColor="{DynamicResource TextPrimary}"
                       BackgroundColor="Transparent"
                       FontSize="14" HeightRequest="46"/>
            </Border>

            <Label x:Name="LblMsg" Text="" FontSize="11" TextColor="#EF4444"
                   HorizontalOptions="Center" IsVisible="False"/>

            <Border BackgroundColor="#1D4ED8"
                    StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="0,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogin"/>
                </Border.GestureRecognizers>
                <Label Text="Masuk" FontSize="14" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center"/>
            </Border>

            <Border BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 14" Stroke="{DynamicResource BorderClr}" Padding="0,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancel"/>
                </Border.GestureRecognizers>
                <Label Text="Batal" FontSize="12" TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"/>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
