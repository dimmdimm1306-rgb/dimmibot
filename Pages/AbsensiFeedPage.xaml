<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.AbsensiFeedPage"
             Title="Absensi"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header (Instagram-style) -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource HeaderBg}"
              Padding="14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Border Grid.Column="0" BackgroundColor="{DynamicResource AccentBlueBg}"
                    StrokeShape="RoundRectangle 10" Padding="12,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack"/>
                </Border.GestureRecognizers>
                <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="📸  KEGIATAN" TextColor="#93C5FD" FontSize="10" FontAttributes="Bold"/>
                <Label x:Name="LblHeader" Text="Feed Kegiatan" TextColor="White" FontSize="14" FontAttributes="Bold"/>
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="2" x:Name="Loader" IsRunning="True" IsVisible="False"
                               Color="#3B82F6" HeightRequest="20"/>
        </Grid>

        <!-- Feed -->
        <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefresh">
            <ScrollView>
                <VerticalStackLayout x:Name="FeedPanel" Padding="0,8,0,80" Spacing="12"/>
            </ScrollView>
        </RefreshView>

        <!-- Bottom: + new post + folder picker -->
        <Grid Grid.Row="2" BackgroundColor="{DynamicResource HeaderBg}"
              Padding="14,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Border Grid.Column="0" BackgroundColor="{DynamicResource CardBg2}"
                    StrokeShape="RoundRectangle 10" Padding="11,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPickFolder"/>
                </Border.GestureRecognizers>
                <Label Text="📁" FontSize="16" TextColor="White"/>
            </Border>
            <Label Grid.Column="1" x:Name="LblFolder" Text="Pilih folder dulu"
                   FontSize="11" TextColor="White" VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>
            <Border Grid.Column="2" BackgroundColor="{DynamicResource AccentGreenBg}"
                    StrokeShape="RoundRectangle 12" Padding="16,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNewPost"/>
                </Border.GestureRecognizers>
                <Label Text="+ Post" FontSize="13" FontAttributes="Bold" TextColor="White"/>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
