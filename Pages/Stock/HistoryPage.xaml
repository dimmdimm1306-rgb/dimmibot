<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.Stock.HistoryPage"
             Title="Riwayat Transaksi"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <!-- Filter bar -->
        <Border Grid.Row="0" BackgroundColor="{DynamicResource HeaderBg}" StrokeThickness="0" Padding="12,8">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <Picker x:Name="PickerGudang" Grid.Column="0" Title="Semua Gudang"
                        FontSize="13" SelectedIndexChanged="OnFilterChanged"
                        TextColor="{DynamicResource TextPrimary}" TitleColor="{DynamicResource TextMuted}"/>
                <Picker x:Name="PickerType" Grid.Column="1" Title="Semua Tipe"
                        FontSize="13" SelectedIndexChanged="OnFilterChanged"
                        TextColor="{DynamicResource TextPrimary}" TitleColor="{DynamicResource TextMuted}">
                    <Picker.Items>
                        <x:String>Semua Tipe</x:String>
                        <x:String>MASUK</x:String>
                        <x:String>KELUAR</x:String>
                        <x:String>TRANSFER</x:String>
                    </Picker.Items>
                </Picker>
                <Button Grid.Column="2" Text="🔄" BackgroundColor="#1E40AF"
                        TextColor="White" CornerRadius="8" WidthRequest="44"
                        Clicked="OnRefresh"/>
            </Grid>
        </Border>

        <RefreshView Grid.Row="1" x:Name="RefreshV" Refreshing="OnRefreshView">
            <CollectionView x:Name="TxList" SelectionMode="None" Margin="12,8">
                <CollectionView.EmptyView>
                    <Label Text="Belum ada transaksi." FontSize="14"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center" Margin="0,40"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource BorderClr}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 10" Margin="0,0,0,8">
                            <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="{Binding MaterialName}" FontSize="14"
                                           FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}"/>
                                    <Label Text="{Binding SubTitle}" FontSize="12"
                                           TextColor="{DynamicResource TextMuted}"/>
                                    <Label FontSize="12" TextColor="{DynamicResource TextMuted}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Date}"/>
                                                <Span Text="  "/>
                                                <Span Text="{Binding ProjectName}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Border BackgroundColor="{Binding TypeBg}" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6" Padding="8,3">
                                        <Label Text="{Binding Type}" FontSize="11"
                                               FontAttributes="Bold" TextColor="{Binding TypeColor}"
                                               HorizontalOptions="Center"/>
                                    </Border>
                                    <Label Text="{Binding QtyDisplay}" FontSize="16"
                                           FontAttributes="Bold" TextColor="{Binding TypeColor}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
