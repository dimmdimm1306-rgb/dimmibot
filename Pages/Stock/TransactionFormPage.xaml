<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:StokBarangMAUI.Controls"
             x:Class="StokBarangMAUI.Pages.Stock.TransactionFormPage"
             Title="Input Transaksi"
             BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border Style="{StaticResource FiberCard}" BackgroundColor="{DynamicResource CardBg2}">
                <VerticalStackLayout Padding="16" Spacing="4">
                    <Label Text="Input Barang" Style="{StaticResource FiberPageTitle}" />
                    <Label Text="Catat barang masuk, keluar, atau transfer antar gudang."
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

            <controls:SectionHeader HeaderTitle="Tipe Transaksi"
                                    HeaderSubtitle="Pilih aksi utama sebelum mengisi barang." />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border x:Name="BtnMasuk"
                        BackgroundColor="{DynamicResource AccentGreenBorder}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTypeMasuk" />
                    </Border.GestureRecognizers>
                    <Label Text="MASUK"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           Padding="0,12" />
                </Border>
                <Border x:Name="BtnKeluar"
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ChipBg}"
                        Stroke="{DynamicResource BorderClr}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTypeKeluar" />
                    </Border.GestureRecognizers>
                    <Label Text="KELUAR"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           Padding="0,12" />
                </Border>
                <Border x:Name="BtnTransfer"
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource ChipBg}"
                        Stroke="{DynamicResource BorderClr}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTypeTransfer" />
                    </Border.GestureRecognizers>
                    <Label Text="TRANSFER"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           Padding="0,12" />
                </Border>
            </Grid>

            <controls:SectionHeader HeaderTitle="Gudang dan Barang"
                                    HeaderSubtitle="Data wajib untuk menjaga stok tetap akurat." />

            <VerticalStackLayout Spacing="8">
                <Label Text="Gudang Asal" Style="{StaticResource FiberMutedText}" />
                <Border Style="{StaticResource FiberInputShell}">
                    <Picker x:Name="PickerGudang"
                            Title="Pilih gudang..."
                            SelectedIndexChanged="OnGudangChanged"
                            FontSize="14"
                            Margin="10,0"
                            TextColor="{DynamicResource TextPrimary}"
                            TitleColor="{DynamicResource TextMuted}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="LblGudangTujuan" Spacing="8" IsVisible="False">
                <Label Text="Gudang Tujuan" Style="{StaticResource FiberMutedText}" />
            </VerticalStackLayout>
            <Border x:Name="BorderGudangTujuan"
                    Style="{StaticResource FiberInputShell}"
                    IsVisible="False">
                <Picker x:Name="PickerGudangTujuan"
                        Title="Pilih gudang tujuan..."
                        FontSize="14"
                        Margin="10,0"
                        TextColor="{DynamicResource TextPrimary}"
                        TitleColor="{DynamicResource TextMuted}" />
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Material" Style="{StaticResource FiberMutedText}" />
                <Border Style="{StaticResource FiberInputShell}">
                    <Picker x:Name="PickerMaterial"
                            Title="Pilih material..."
                            SelectedIndexChanged="OnMaterialChanged"
                            FontSize="14"
                            Margin="10,0"
                            TextColor="{DynamicResource TextPrimary}"
                            TitleColor="{DynamicResource TextMuted}" />
                </Border>
            </VerticalStackLayout>

            <Border x:Name="BorderStokInfo"
                    BackgroundColor="{DynamicResource AccentBlueBg}"
                    Stroke="{DynamicResource AccentBlueBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    IsVisible="False">
                <Label x:Name="LblStokTersedia"
                       Padding="14,10"
                       FontSize="13"
                       TextColor="{DynamicResource FiberCyan}" />
            </Border>

            <controls:SectionHeader HeaderTitle="Detail Pemakaian"
                                    HeaderSubtitle="Qty wajib, proyek dan catatan opsional." />

            <VerticalStackLayout Spacing="8">
                <Label Text="Jumlah (Qty)" Style="{StaticResource FiberMutedText}" />
                <Border Style="{StaticResource FiberInputShell}">
                    <Entry x:Name="EntryQty"
                           Placeholder="0"
                           Keyboard="Numeric"
                           FontSize="18"
                           Margin="10,4"
                           TextColor="{DynamicResource TextPrimary}"
                           PlaceholderColor="{DynamicResource TextMuted}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Nama Proyek" Style="{StaticResource FiberMutedText}" />
                <Border Style="{StaticResource FiberInputShell}">
                    <Entry x:Name="EntryProyek"
                           Placeholder="Opsional, contoh: FTTH Brebes A"
                           FontSize="14"
                           Margin="10,4"
                           TextColor="{DynamicResource TextPrimary}"
                           PlaceholderColor="{DynamicResource TextMuted}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Catatan" Style="{StaticResource FiberMutedText}" />
                <Border Style="{StaticResource FiberInputShell}">
                    <Editor x:Name="EditorNotes"
                            Placeholder="Opsional, contoh: dipakai tim instalasi area barat"
                            AutoSize="TextChanges"
                            FontSize="14"
                            Margin="10,4"
                            MinimumHeightRequest="72"
                            TextColor="{DynamicResource TextPrimary}"
                            PlaceholderColor="{DynamicResource TextMuted}" />
                </Border>
            </VerticalStackLayout>

            <Button x:Name="BtnSave"
                    Text="Simpan Transaksi"
                    Clicked="OnSimpan"
                    Style="{StaticResource FiberPrimaryButton}"
                    Margin="0,4,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
