<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:StokBarangMAUI.Controls"
             x:Class="StokBarangMAUI.Pages.Stock.MaterialFormPage"
             Title="Form Material"
             BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border Style="{StaticResource FiberCard}" BackgroundColor="{DynamicResource CardBg2}">
                <VerticalStackLayout Padding="16" Spacing="4">
                    <Label Text="Input Barang" Style="{StaticResource FiberPageTitle}" />
                    <Label Text="Buat master material yang mudah dicari saat transaksi gudang."
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

            <controls:SectionHeader HeaderTitle="Informasi Barang"
                                    HeaderSubtitle="Nama dan kategori dipakai untuk pencarian cepat." />

            <VerticalStackLayout Spacing="8">
                <Label Text="Nama Material" Style="{StaticResource FiberMutedText}" />
                <Border Style="{StaticResource FiberInputShell}">
                    <Entry x:Name="EntryName"
                           Placeholder="Contoh: Kabel 24C"
                           Margin="10,4"
                           FontSize="15"
                           TextColor="{DynamicResource TextPrimary}"
                           PlaceholderColor="{DynamicResource TextMuted}" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="Satuan" Style="{StaticResource FiberMutedText}" />
                    <Border Style="{StaticResource FiberInputShell}">
                        <Entry x:Name="EntryUnit"
                               Placeholder="pcs / meter / roll"
                               Margin="10,4"
                               FontSize="15"
                               TextColor="{DynamicResource TextPrimary}"
                               PlaceholderColor="{DynamicResource TextMuted}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="Kategori" Style="{StaticResource FiberMutedText}" />
                    <Border Style="{StaticResource FiberInputShell}">
                        <Entry x:Name="EntryCategory"
                               Placeholder="Kabel / Aksesori"
                               Margin="10,4"
                               FontSize="15"
                               TextColor="{DynamicResource TextPrimary}"
                               PlaceholderColor="{DynamicResource TextMuted}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <controls:SectionHeader HeaderTitle="Peringatan Stok"
                                    HeaderSubtitle="Nilai minimum dipakai untuk badge warning di dashboard." />

            <VerticalStackLayout Spacing="8">
                <Label Text="Stok Minimum" Style="{StaticResource FiberMutedText}" />
                <Border Style="{StaticResource FiberInputShell}">
                    <Entry x:Name="EntryMinStock"
                           Placeholder="0"
                           Keyboard="Numeric"
                           Margin="10,4"
                           FontSize="15"
                           TextColor="{DynamicResource TextPrimary}"
                           PlaceholderColor="{DynamicResource TextMuted}" />
                </Border>
            </VerticalStackLayout>

            <Button x:Name="BtnSave"
                    Text="Simpan Material"
                    Clicked="OnSimpan"
                    Style="{StaticResource FiberPrimaryButton}"
                    Margin="0,4,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
