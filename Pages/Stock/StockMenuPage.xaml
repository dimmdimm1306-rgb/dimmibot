<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StokBarangMAUI.Pages.Stock.StockMenuPage"
             Title="Stok Gudang"
             BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Header -->
            <Border BackgroundColor="#1E40AF" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Padding="20,16" Spacing="4">
                    <Label Text="📦 Stok Multi-Gudang"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label x:Name="LblSubtitle"
                           Text="Memuat data..."
                           FontSize="13" TextColor="#BFDBFE"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Stats Row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{DynamicResource CardBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Padding="12,10" Spacing="2">
                        <Label x:Name="LblWarehouses" Text="–" FontSize="22" FontAttributes="Bold"
                               TextColor="#3B82F6" HorizontalOptions="Center"/>
                        <Label Text="Gudang" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{DynamicResource CardBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Padding="12,10" Spacing="2">
                        <Label x:Name="LblMaterials" Text="–" FontSize="22" FontAttributes="Bold"
                               TextColor="#3B82F6" HorizontalOptions="Center"/>
                        <Label Text="Material" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="{DynamicResource CardBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Padding="12,10" Spacing="2">
                        <Label x:Name="LblLowStock" Text="–" FontSize="22" FontAttributes="Bold"
                               TextColor="#DC2626" HorizontalOptions="Center"/>
                        <Label Text="Stok Kurang" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Alert Banner -->
            <Border x:Name="AlertBanner" BackgroundColor="#FEF3C7" Stroke="#FCD34D"
                    StrokeThickness="1" StrokeShape="RoundRectangle 8" IsVisible="False">
                <Label x:Name="LblAlert" Padding="12,8" FontSize="13" TextColor="#92400E"/>
            </Border>

            <!-- Menu Grid -->
            <Label Text="Menu Utama" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BorderClr}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboard"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                        <Label Text="📊" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="Dashboard" FontSize="14" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Ringkasan stok" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BorderClr}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTransaksi"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                        <Label Text="➕" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="Transaksi" FontSize="14" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Masuk / Keluar" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BorderClr}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRiwayat"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                        <Label Text="📋" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="Riwayat" FontSize="14" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Histori transaksi" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BorderClr}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLaporan"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                        <Label Text="📄" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="Laporan" FontSize="14" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Export CSV" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BorderClr}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGudang"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                        <Label Text="🏭" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="Gudang" FontSize="14" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Master gudang" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BorderClr}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBarang"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                        <Label Text="🗂️" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="Master Barang" FontSize="14" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Kelola material" FontSize="11" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
