<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:StokBarangMAUI.Controls"
             x:Class="StokBarangMAUI.Pages.Stock.StockMenuPage"
             Title="Stok Gudang"
             BackgroundColor="{DynamicResource PageBg}">

    <RefreshView x:Name="RefreshV" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <Border Style="{StaticResource FiberCard}" BackgroundColor="{DynamicResource CardBg2}">
                    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="14" RowSpacing="6">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="Stok Barang"
                                   Style="{StaticResource FiberPageTitle}" />
                            <Label x:Name="LblSubtitle"
                                   Text="Memuat ringkasan stok..."
                                   FontSize="13"
                                   TextColor="{DynamicResource TextSecond}" />
                        </VerticalStackLayout>
                        <controls:StatusBadge Grid.Row="0" Grid.Column="1"
                                              BadgeText="SYNC OK"
                                              BadgeBackground="{DynamicResource SuccessBg}"
                                              BadgeTextColor="{DynamicResource SuccessText}"
                                              VerticalOptions="Start" />
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2"
                                 HeightRequest="1"
                                 BackgroundColor="{DynamicResource DividerClr}"
                                 Margin="0,8" />
                        <Label Grid.Row="2" Grid.ColumnSpan="2"
                               Text="Pantau stok lapangan, input transaksi, dan cek status gudang dari satu layar."
                               FontSize="13"
                               TextColor="{DynamicResource TextMuted}" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <controls:StatCard x:Name="CardWarehouses"
                                       Grid.Row="0" Grid.Column="0"
                                       CardTitle="Gudang"
                                       IconText="GD"
                                       AccentColor="{DynamicResource FiberCyan}"
                                       AccentBackground="{DynamicResource AccentBlueBg}" />
                    <controls:StatCard x:Name="CardMaterials"
                                       Grid.Row="0" Grid.Column="1"
                                       CardTitle="Barang"
                                       IconText="BR"
                                       AccentColor="{DynamicResource FiberBlue}"
                                       AccentBackground="{DynamicResource AccentBlueBg}" />
                    <controls:StatCard x:Name="CardLowStock"
                                       Grid.Row="1" Grid.Column="0"
                                       CardTitle="Perlu Cek"
                                       IconText="AL"
                                       AccentColor="{DynamicResource WarningText}"
                                       AccentBackground="{DynamicResource WarningBg}" />
                    <controls:StatCard x:Name="CardTodayTx"
                                       Grid.Row="1" Grid.Column="1"
                                       CardTitle="Hari Ini"
                                       IconText="IN"
                                       AccentColor="{DynamicResource FiberGreen}"
                                       AccentBackground="{DynamicResource SuccessBg}" />
                </Grid>

                <Border x:Name="AlertBanner"
                        BackgroundColor="{DynamicResource WarningBg}"
                        Stroke="{DynamicResource WarningText}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        IsVisible="False">
                    <Label x:Name="LblAlert"
                           Padding="14,10"
                           FontSize="13"
                           TextColor="{DynamicResource WarningText}" />
                </Border>

                <controls:SectionHeader HeaderTitle="Shortcut Lapangan"
                                        HeaderSubtitle="Aksi besar, minim klik." />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <controls:ActionCard Grid.Row="0" Grid.Column="0"
                                         CardTitle="Dashboard"
                                         CardSubtitle="Kondisi stok"
                                         IconText="DB"
                                         AccentColor="{DynamicResource FiberCyan}">
                        <controls:ActionCard.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDashboard" />
                        </controls:ActionCard.GestureRecognizers>
                    </controls:ActionCard>

                    <controls:ActionCard Grid.Row="0" Grid.Column="1"
                                         CardTitle="Input Barang"
                                         CardSubtitle="Masuk, keluar, transfer"
                                         IconText="IN"
                                         AccentColor="{DynamicResource FiberGreen}">
                        <controls:ActionCard.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTransaksi" />
                        </controls:ActionCard.GestureRecognizers>
                    </controls:ActionCard>

                    <controls:ActionCard Grid.Row="1" Grid.Column="0"
                                         CardTitle="Stok Barang"
                                         CardSubtitle="Master material"
                                         IconText="ST"
                                         AccentColor="{DynamicResource FiberBlue}">
                        <controls:ActionCard.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBarang" />
                        </controls:ActionCard.GestureRecognizers>
                    </controls:ActionCard>

                    <controls:ActionCard Grid.Row="1" Grid.Column="1"
                                         CardTitle="Gudang"
                                         CardSubtitle="Lokasi dan area"
                                         IconText="GD"
                                         AccentColor="{DynamicResource FiberCyan}">
                        <controls:ActionCard.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGudang" />
                        </controls:ActionCard.GestureRecognizers>
                    </controls:ActionCard>

                    <controls:ActionCard Grid.Row="2" Grid.Column="0"
                                         CardTitle="Riwayat"
                                         CardSubtitle="Audit transaksi"
                                         IconText="RY"
                                         AccentColor="{DynamicResource TextSecond}">
                        <controls:ActionCard.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRiwayat" />
                        </controls:ActionCard.GestureRecognizers>
                    </controls:ActionCard>

                    <controls:ActionCard Grid.Row="2" Grid.Column="1"
                                         CardTitle="Laporan"
                                         CardSubtitle="Export CSV"
                                         IconText="EX"
                                         AccentColor="{DynamicResource WarningText}">
                        <controls:ActionCard.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLaporan" />
                        </controls:ActionCard.GestureRecognizers>
                    </controls:ActionCard>
                </Grid>

                <controls:SectionHeader HeaderTitle="Aktivitas Terbaru"
                                        HeaderSubtitle="Transaksi terakhir di stock gudang." />

                <CollectionView x:Name="RecentList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FiberCard}" Margin="0,0,0,8">
                                <Grid Padding="14,12" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding MaterialName}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="{Binding SubTitle}"
                                               FontSize="12"
                                               TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding QtyDisplay}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{Binding TypeColor}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Date}"
                                           FontSize="11"
                                           TextColor="{DynamicResource TextMuted}" />
                                    <Border Grid.Row="1" Grid.Column="1"
                                            BackgroundColor="{Binding TypeBg}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,3"
                                            HorizontalOptions="End">
                                        <Label Text="{Binding Type}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{Binding TypeColor}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <controls:EmptyState x:Name="RecentEmpty"
                                     EmptyTitle="Belum ada aktivitas"
                                     EmptyMessage="Transaksi masuk, keluar, atau transfer akan tampil di sini."
                                     IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
