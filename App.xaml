<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:StokBarangMAUI"
             xmlns:converters="clr-namespace:StokBarangMAUI.Converters"
             x:Class="StokBarangMAUI.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StokColorConverter x:Key="StokColorConverter" />

            <!-- Theme-aware semantic colors (defaults = dark; overwritten by ThemeService) -->
            <Color x:Key="PageBg">#07111F</Color>
            <Color x:Key="CardBg">#0E1A2B</Color>
            <Color x:Key="CardBg2">#10243A</Color>
            <Color x:Key="TextPrimary">#F6FBFF</Color>
            <Color x:Key="TextSecond">#B8D7EA</Color>
            <Color x:Key="TextMuted">#7FA1B9</Color>
            <Color x:Key="BorderClr">#1C3950</Color>
            <Color x:Key="DividerClr">#123047</Color>
            <Color x:Key="SearchBg">#0B1B2D</Color>
            <Color x:Key="HeaderBg">#07111F</Color>
            <Color x:Key="SubHeaderBg">#0B1B2D</Color>

            <!-- Accent colors -->
            <Color x:Key="AccentBlueBg">#0B2A4A</Color>
            <Color x:Key="AccentBlueBorder">#0EA5E9</Color>
            <Color x:Key="AccentBlue">#38BDF8</Color>
            <Color x:Key="AccentGreenBg">#073B31</Color>
            <Color x:Key="AccentGreenBorder">#10B981</Color>
            <Color x:Key="AccentRedBg">#4C151D</Color>
            <Color x:Key="AccentRedBorder">#F43F5E</Color>

            <!-- Stat card text -->
            <Color x:Key="StatBlueText">#A5F3FC</Color>
            <Color x:Key="StatGreenText">#6EE7B7</Color>
            <Color x:Key="StatRedText">#FCA5A5</Color>
            <Color x:Key="StatBlueLabel">#67E8F9</Color>
            <Color x:Key="StatGreenLabel">#34D399</Color>
            <Color x:Key="StatRedLabel">#F87171</Color>

            <!-- Stat value colors (numbers in summary cards) - theme aware -->
            <Color x:Key="StatBlueValue">#22D3EE</Color>
            <Color x:Key="StatOrangeValue">#FBBF24</Color>
            <Color x:Key="StatPurpleValue">#C084FC</Color>
            <Color x:Key="StatGreenValue">#4ADE80</Color>

            <!-- Drawer / menu -->
            <Color x:Key="DrawerBg">#0D1117</Color>
            <Color x:Key="DrawerHeaderBg">#161B22</Color>
            <Color x:Key="DrawerItemBg">#161B22</Color>
            <Color x:Key="DrawerItemBorder">#21262D</Color>
            <Color x:Key="DrawerBottomBg">#161B22</Color>

            <!-- Console / Bot -->
            <Color x:Key="ConsoleBg">#0F172A</Color>
            <Color x:Key="ConsoleBorder">#1E293B</Color>
            <Color x:Key="ConsoleText">#94A3B8</Color>

            <!-- Header button tints -->
            <Color x:Key="HeaderBtnBg">#0B2A4A</Color>
            <Color x:Key="HeaderBtnBorder">#0EA5E9</Color>
            <Color x:Key="HeaderSubtitle">#A5F3FC</Color>

            <!-- Modern UI tokens -->
            <Color x:Key="SurfaceRaised">#14243A</Color>
            <Color x:Key="FiberCyan">#22D3EE</Color>
            <Color x:Key="FiberBlue">#38BDF8</Color>
            <Color x:Key="FiberGreen">#34D399</Color>
            <Color x:Key="SuccessBg">#073B31</Color>
            <Color x:Key="SuccessText">#6EE7B7</Color>
            <Color x:Key="WarningBg">#422006</Color>
            <Color x:Key="WarningText">#FCD34D</Color>
            <Color x:Key="DangerBg">#4C151D</Color>
            <Color x:Key="DangerText">#FDA4AF</Color>
            <Color x:Key="ChipBg">#10243A</Color>
            <Color x:Key="ChipSelectedBg">#0E7490</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
