GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_PRIVATE_KEY_ANDA\n-----END PRIVATE KEY-----\n"
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_SHEET_ID=isi_id_spreadsheet
GOOGLE_DRIVE_FOLDER_ID=isi_id_folder_drive
SHEET_NAME=Arsip
DATA_SHEET_ID=isi_id_spreadsheet_data
DATA_SHEET_NAME=Progress
DATA_UPDATE_INTERVAL=86400000
ALLOWED_GROUP_OR_NUMBER=
LOG_CHAT_ID=true
SEND_REPLY=false
CASUAL_REPLY=true
REQUIRE_MENTION=true
AI_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Multi-Provider AI (api-server.js) ─────────────────────────────────
# OPENAI_API_KEY = key OpenRouter (legacy nama; jangan diganti)
OPENAI_API_KEY=sk-or-v1-xxx_openrouter_key

# Optional: kalau diisi, server akan fallback ke OpenAI direct saat OpenRouter limit
OPENAI_DIRECT_API_KEY=sk-xxx_openai_direct_key

# Optional: kalau diisi, server akan fallback ke Claude direct saat 2 di atas limit
ANTHROPIC_API_KEY=sk-ant-xxx_anthropic_key

# Daftar model fallback (comma-separated). Server akan coba urut dari kiri.
# Convention prefix:
#   xxx/yyy (ada slash)  → via OpenRouter (cth: deepseek/deepseek-v4-flash,
#                          openai/gpt-oss-120b:free, openrouter/owl-alpha)
#   gpt-4o, o1-mini      → via OpenAI direct (no slash)
#   openai-direct/gpt-4o → via OpenAI direct (kalau mau eksplisit)
#   claude-haiku-4-5-... → via Anthropic direct (HEMAT — pakai Haiku, bukan Opus)
FALLBACK_MODELS=deepseek/deepseek-v4-flash,openrouter/owl-alpha,openai/gpt-oss-120b:free,openai/gpt-oss-20b:free,claude-haiku-4-5-20251001

DEFAULT_MODEL=openrouter/owl-alpha
API_PORT=20128
PUBLIC_URL=https://your-cloudflare-tunnel.trycloudflare.com/v1